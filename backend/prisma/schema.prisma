generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Hero {
  id            Int           @id
  name          String
  className     String?
  imageUrl      String?
  cardUrl       String?
  isPlayable    Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Item {
  id            BigInt        @id
  name          String
  cost          Int
  tier          Int?
  category      String?
  imageUrl      String?
  nameRu        String?
  /// Нормализованный тултип (src/sync/item-tooltip.ts), без HTML.
  tooltip       Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  password      String

  savedBuilds   SavedBuild[]        
}

model SavedBuild {
  id            String        @id @default(uuid())
  name          String
  heroId        Int
  itemIds       BigInt[]
  createdAt     DateTime      @default(now())

  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
}
